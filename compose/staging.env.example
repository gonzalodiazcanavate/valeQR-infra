# Copiar a .env junto a compose/docker-compose.yml en el servidor (NO versionar el real).
# El fichero real se guarda cifrado con sops en secrets/prod.env.enc (ver docs/secrets.md).
APP_DOMAIN=staging.autoqr.com
API_DOMAIN=api.staging.autoqr.com
WEB_ROOT=/srv/autoqr-staging/web

# Tag inmutable de la imagen del API (sha-<commit> o vX.Y.Z). Lo escribe scripts/deploy.sh.
API_TAG=latest

# Contraseñas: generar con `openssl rand -base64 32`. Solo se usan al crear el volumen de PostgreSQL.
POSTGRES_PASSWORD=
AUTOQR_OWNER_PASSWORD=
AUTOQR_APP_PASSWORD=

LOG_LEVEL=info
MIN_APP_VERSION=0.0.0

# Copias de seguridad (scripts/backup.sh)
BACKUP_DIR=/srv/autoqr-staging/backups
# Clave pública age (age1...) con la que se cifran las copias. La clave privada NO está en el servidor.
BACKUP_AGE_RECIPIENT=
# Destino remoto rclone (opcional), p. ej. remoto:bucket/autoqr. Vacío = solo copia local.
BACKUP_RCLONE_REMOTE=
BACKUP_RETENTION_DAYS=30
